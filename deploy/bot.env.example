# Шаблон окружения AI-бота. Реальные значения задаются на сервере и в GitHub Secrets.
BOT_TOKEN=
BOT_DB_URL=
BOT_DB_USER=ai_user
BOT_DB_PASSWORD=
# Ключи провайдеров: один провайдер — одна переменная, ни один не обязателен.
BOT_AI_KEY_DEEPSEEK=
BOT_AI_KEY_GROK=
BOT_AI_KEY_OPENAI=
BOT_AI_KEY_GEMINI=
BOT_AI_KEY_MISTRAL=
BOT_AI_KEY_AITUNNEL=
BOT_AI_KEY_VENICE=
BOT_AI_KEY_ABLITERATION=
# Необязательно: пользователь и адрес сервера для команды SSH-туннеля
# в уведомлении о запуске. Без них строка туннеля не печатается.
BOT_SSH_USER=
BOT_SSH_HOST=
# Прокси нужен только если на сервере нет прямого доступа к Telegram.
BOT_PROXY_TYPE=
BOT_PROXY_HOST=
BOT_PROXY_PORT=
BOT_PROXY_USER=
BOT_PROXY_PASS=
