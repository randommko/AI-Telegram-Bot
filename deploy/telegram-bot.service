[Unit]
Description=Telegram bot (telegram-bot-1.0.jar)
Wants=network-online.target openvpn@tg-relay.service
After=network-online.target openvpn@tg-relay.service postgresql.service
# Перезапускаться бесконечно: бот сам делает 3 попытки registerBot и выходит.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/usr/bin/tg_bot
# Секреты передаются переменными окружения: аргументы командной строки видны в ps.
EnvironmentFile=/etc/telegram-bot/bot.env
ExecStart=/usr/bin/java -jar /usr/bin/tg_bot/telegram-bot-1.0.jar
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
